
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/dj",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/dj",
      "destination": "https://landing-page-dj-git-main-offshorecreative.vercel.app/"
    },
    {
      "source": "/dj/:path*",
      "destination": "https://landing-page-dj-git-main-offshorecreative.vercel.app/:path*"
    },
    {
      "source": "/property",
      "destination": "https://landing-page-property-eta.vercel.app/"
    },
    {
      "source": "/property/:path*",
      "destination": "https://landing-page-property-eta.vercel.app/:path*"
    }
  ]
}
