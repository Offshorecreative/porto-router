
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/dj/",
      "permanent": false
    },
    {
      "source": "/dj",
      "destination": "/dj/",
      "permanent": false
    },
    {
      "source": "/property",
      "destination": "/property/",
      "permanent": false
    },
    {
      "source": "/fashion",
      "destination": "/fashion/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/dj/",
      "destination": "https://landing-page-dj-six.vercel.app/"
    },
    {
      "source": "/dj/:path*",
      "destination": "https://landing-page-dj-six.vercel.app/:path*"
    },
    {
      "source": "/property/",
      "destination": "https://landing-page-property-one.vercel.app/"
    },
    {
      "source": "/property/:path*",
      "destination": "https://landing-page-property-one.vercel.app/:path*"
    },
    {
      "source": "/fashion/",
      "destination": "https://fashion-eight-fawn.vercel.app/"
    },
    {
      "source": "/fashion/:path*",
      "destination": "https://fashion-eight-fawn.vercel.app/:path*"
    }
  ]
}
